            </div>
        </div>
        <button class="carousel-control-prev w-auto" type="button" data-bs-target="#carouselOfLockers" data-bs-slide="prev">
            <span class="carousel-control-prev-icon bg-dark border border-dark rounded-circle p-2" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next w-auto" type="button" data-bs-target="#carouselOfLockers" data-bs-slide="next">
