@model UserModel;

@{
    ViewData["Title"] = "Cadastro de Usuário";
}
<style>
    input.form-control:focus {
        box-shadow: 0 0 5px 2px green;
        outline: none;
    }
    
    h2.text-gray-800 {
        color: #343a40;
    }
</style>
<div class="d-flex gap-5">
    <div class="col-3 m-auto">
        <div>
            <h2 class="text-gray-800 fs-1 fw-2">Cadastre-se</h2>
        </div>
    </div>
    
    <div class="col-6 d-flex align-items-center py-4">
        <form 
            class="col-10 d-flex pb-4 flex-column align-items-center 
        justify-content-center gap-2 bg-white needs-validation rounded-3 
        shadow-lg py-2" 
            novalidate
              asp-controller="User" asp-action="Register" method="post">
            <div class="col-10 border-bottom py-2 text-center">
                <span class="fs-4 text-secondary">Criar uma nova 
                    conta</span>
            </div>
            <div class="col-10">
                <label for="firstname" class="form-label">Nome</label>
                <input type="text" asp-for="Name" class="form-control"
                       id="firstname" placeholder="Digite seu nome" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="col-md-10">
                <label for="lastname" class="form-label">Sobrenome</label>
                <input type="text" class="form-control" id="lastname"
                       placeholder="Digite seu sobrenome" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="col-md-10">
                <label for="email" class="form-label">Email</label>
                <input type="email" asp-for="Email" class="form-control"
                       id="email" placeholder="Digite seu email" required>
                <div class="invalid-feedback">
                    Please provide a valid city.
                </div>
            </div>
            <div class="col-md-10">
                <label for="course" class="form-label">Curso</label>
                <input type="text" asp-for="Curso" class="form-control" id="course"
                       placeholder="Informe o seu curso" required>
                <div class="invalid-feedback">
                    Please select a valid state.
                </div>
            </div>
            <div class="col-md-10">
                <label for="password" class="form-label">Senha</label>
                <input type="password" asp-for="Password" class="form-control"
                       placeholder="********" id="password"
                       required>
                <div class="invalid-feedback">
                    Please select a valid state.
                </div>
            </div>
            <div class="col-md-10">
                <label for="passwordConfirm" class="form-label">Confirmar Senha</label>
                <input type="password" class="form-control" id="passwordConfirm"
                       placeholder="********" required>
                <div class="invalid-feedback">
                    Please provide a valid zip.
                </div>
            </div>
    
            <div class="col-10 d-grid my-3">
                <button class="btn btn-outline-success" type="submit">Cadastrar</button>
            </div>
        </form>
    </div>
</div>
