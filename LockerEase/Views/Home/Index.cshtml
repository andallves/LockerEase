                                </div>
                                <span class="text-dark fs-6 fw-medium">Usuário 1</span>
                            </div>
                            <div class="d-flex justify-content-around">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                            </div>
                        </div>
                        <div>
                            <p>Descrição da avaliação</p>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-2 bg-green-300 box-shadow p-3 rounded rounded-md" style="width: 200px; height: 100px;" >
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-2 align-items-center">
                                <div class="bg-secondary" style="border-radius: 50%; overflow: hidden;">
                                    <img src="assets/perfil.png" alt="" width="28" height="28" style="border-radius: 50;">
                                </div>
                                <span class="text-dark fs-6 fw-medium">Usuário 1</span>
                            </div>
                            <div class="d-flex justify-content-around">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                            </div>
                        </div>
                        <div>
                            <p>Descrição da avaliação</p>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-2 bg-green-300 box-shadow p-3 rounded rounded-md" style="width: 200px; height: 100px;" >
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-2 align-items-center">
                                <div class="bg-secondary" style="border-radius: 50%; overflow: hidden;">
                                    <img src="assets/perfil.png" alt="" width="28" height="28" style="border-radius: 50;">
                                </div>
                                <span class="text-dark fs-6 fw-medium">Usuário 1</span>
                            </div>
                            <div class="d-flex justify-content-around">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                                <img src="assets/star.svg" alt="" width="10" height="10">
                            </div>
                        </div>
                        <div>
                            <p>Descrição da avaliação</p>
                        </div>
                    </div>
                </div>
            </div>
            <div style="width: 500px; height: 500px;">
                <img src="assets/avaliacao-armario.jpg" alt="" style="width: 500px; height: 500px;">
            </div>
        </article>
    </section>
</div>